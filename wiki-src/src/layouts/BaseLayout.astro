---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import { SITE } from '../site.config';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  /** mostra o menu lateral fixo no desktop */
  sidebar?: boolean;
  currentSlug?: string;
  currentCategory?: string;
}

const {
  title,
  description = SITE.description,
  image = SITE.ogImage,
  type = 'website',
  noindex = false,
  jsonLd = [],
  sidebar = false,
  currentSlug,
  currentCategory,
} = Astro.props;

const base = Astro.site ?? new URL(SITE.siteUrl);
const fullTitle = title === SITE.gameName ? `${SITE.gameName} — ${SITE.wikiName}` : `${title} · ${SITE.wikiName}`;
const canonical = new URL(Astro.url.pathname, base).href;
const ogImage = new URL(image, base).href;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={SITE.themeColor} />
    <link rel="icon" href="/wiki/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/wiki/apple-touch-icon.png" />
    <link rel="sitemap" href="/wiki/sitemap.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.wikiName} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}

    <script is:inline>
      (function () {
        var t = 'light';
        try {
          t = localStorage.getItem('theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        } catch (e) {}
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body class:list={[{ 'has-sidebar': sidebar }]}>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <div class="drawer-backdrop" data-drawer-close hidden></div>
    <div class="shell">
      <aside id="drawer" class="drawer" aria-label="Categorias da wiki">
        <div class="drawer__head">
          <span>Navegação</span>
          <button class="icon-btn" type="button" data-drawer-close aria-label="Fechar menu">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"></path></svg>
          </button>
        </div>
        <Sidebar currentSlug={currentSlug} currentCategory={currentCategory} />
      </aside>
      <main id="conteudo" class="main" tabindex="-1">
        <slot />
      </main>
    </div>
    <Footer />
    <button class="to-top" type="button" aria-label="Voltar ao topo" data-to-top hidden>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"></path></svg>
    </button>

    <script>
      const root = document.documentElement;
      const body = document.body;

      // ---------- tema claro/escuro ----------
      const syncThemeButtons = () => {
        const dark = root.dataset.theme === 'dark';
        document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) => {
          b.setAttribute('aria-pressed', String(dark));
          b.setAttribute('aria-label', dark ? 'Ativar modo claro' : 'Ativar modo escuro');
        });
      };
      document.querySelectorAll('[data-theme-toggle]').forEach((btn) =>
        btn.addEventListener('click', () => {
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem('theme', next);
          } catch {
            /* navegação privada */
          }
          syncThemeButtons();
        }),
      );
      syncThemeButtons();

      // ---------- menu lateral (mobile) ----------
      const backdrop = document.querySelector<HTMLElement>('.drawer-backdrop');
      const toggles = document.querySelectorAll<HTMLButtonElement>('[data-drawer-toggle]');
      const setDrawer = (open: boolean) => {
        body.classList.toggle('drawer-open', open);
        if (backdrop) backdrop.hidden = !open;
        toggles.forEach((t) => t.setAttribute('aria-expanded', String(open)));
        if (open) document.querySelector<HTMLElement>('#drawer a')?.focus();
      };
      toggles.forEach((t) => t.addEventListener('click', () => setDrawer(!body.classList.contains('drawer-open'))));
      document.querySelectorAll('[data-drawer-close]').forEach((el) => el.addEventListener('click', () => setDrawer(false)));
      document.querySelectorAll('#drawer a').forEach((a) => a.addEventListener('click', () => setDrawer(false)));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && body.classList.contains('drawer-open')) setDrawer(false);
      });

      // ---------- voltar ao topo ----------
      const toTop = document.querySelector<HTMLButtonElement>('[data-to-top]');
      if (toTop) {
        const onScroll = () => {
          toTop.hidden = window.scrollY < 600;
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
        toTop.addEventListener('click', () => {
          const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
          document.getElementById('conteudo')?.focus({ preventScroll: true });
        });
      }
    </script>
  </body>
</html>
