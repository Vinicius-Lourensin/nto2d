---
import { SITE } from '../site.config';
---

<header class="site-header">
  <div class="site-header__inner">
    <button class="icon-btn menu-btn" type="button" data-drawer-toggle aria-controls="drawer" aria-expanded="false" aria-label="Abrir menu de categorias">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"></path></svg>
    </button>

    <a href="/wiki/" class="brand" aria-label={`${SITE.wikiName} — página inicial`}>
      <img src={SITE.logo} width="36" height="36" alt="" />
      <span class="brand__text">
        <strong>{SITE.gameName}</strong>
        <small>Wiki</small>
      </span>
    </a>

    <nav class="top-nav" aria-label="Principal">
      <a href="/wiki/guia-rapido/">Guia para iniciantes</a>
      <a href="/wiki/paginas/">Todas as páginas</a>
      <a href="/">Site do jogo</a>
      {SITE.discordUrl && <a href={SITE.discordUrl} rel="noopener" target="_blank">Discord</a>}
    </nav>

    <form class="search-form" action="/wiki/busca/" method="get" role="search">
      <label class="sr-only" for="busca-topo">Buscar na wiki</label>
      <svg class="search-form__icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" fill="none"></circle><path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
      <input id="busca-topo" name="q" type="search" placeholder="Buscar jutsus, itens, sistemas…" autocomplete="off" />
    </form>

    <a class="icon-btn search-link" href="/wiki/busca/" aria-label="Buscar na wiki">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" fill="none"></circle><path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
    </a>

    <button class="icon-btn theme-btn" type="button" data-theme-toggle aria-label="Alternar modo escuro" aria-pressed="false">
      <svg class="theme-btn__moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" fill="currentColor"></path></svg>
      <svg class="theme-btn__sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"></circle><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
    </button>
  </div>
</header>
