---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Toc from '../components/Toc.astro';
import PrevNext from '../components/PrevNext.astro';
import ArticleCard from '../components/ArticleCard.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { SITE } from '../site.config';
import { getCategory } from '../data/categories';
import { getArticles, categoryUrl, formatDate, resolveRelated, type WikiEntry } from '../lib/wiki';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: articles[i - 1] ?? null, next: articles[i + 1] ?? null },
  }));
}

interface Props {
  entry: WikiEntry;
  prev: WikiEntry | null;
  next: WikiEntry | null;
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const category = getCategory(entry.data.category)!;
const all = await getArticles();
const related = resolveRelated(entry, all);

const site = Astro.site ?? new URL(SITE.siteUrl);
const pageUrl = new URL(Astro.url.pathname, site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: entry.data.title,
    description: entry.data.description,
    dateModified: entry.data.updated.toISOString(),
    inLanguage: SITE.lang,
    mainEntityOfPage: pageUrl,
    image: new URL(entry.data.image ?? SITE.ogImage, site).href,
    articleSection: category.title,
    keywords: entry.data.keywords.join(', '),
    publisher: {
      '@type': 'Organization',
      name: SITE.wikiName,
      logo: { '@type': 'ImageObject', url: new URL(SITE.logo, site).href },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: new URL('/', site).href },
      { '@type': 'ListItem', position: 2, name: category.title, item: new URL(categoryUrl(category.slug), site).href },
      { '@type': 'ListItem', position: 3, name: entry.data.title, item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.image}
  type="article"
  jsonLd={jsonLd}
  sidebar
  currentSlug={entry.id}
  currentCategory={entry.data.category}
>
  <div class="article-layout">
    <article
      class="article"
      data-pagefind-body
      data-pagefind-meta={`categoria:${category.title}`}
      data-pagefind-filter={`categoria:${category.title}`}
    >
      <Breadcrumbs
        items={[
          { label: 'Início', href: '/wiki/' },
          { label: category.title, href: categoryUrl(category.slug) },
          { label: entry.data.title },
        ]}
      />

      <header class="article__header">
        <a class="eyebrow" href={categoryUrl(category.slug)} data-pagefind-ignore>
          <span aria-hidden="true">{category.icon}</span>
          {category.title}
        </a>
        <h1>{entry.data.title}</h1>
        <p class="lead">{entry.data.description}</p>
        <div class="article__meta" data-pagefind-ignore>
          <StatusBadge status={entry.data.status} />
          <span>Atualizado em <time datetime={entry.data.updated.toISOString()}>{formatDate(entry.data.updated)}</time></span>
        </div>
      </header>

      {
        entry.data.image && (
          <figure class="article__hero">
            <img src={entry.data.image} alt={entry.data.imageAlt ?? ''} loading="lazy" decoding="async" />
          </figure>
        )
      }

      {
        headings.filter((h) => h.depth === 2 || h.depth === 3).length >= 2 && (
          <details class="toc-mobile" data-pagefind-ignore>
            <summary>Nesta página</summary>
            <Toc headings={headings} id="toc-mobile" />
          </details>
        )
      }

      <div class="prose">
        <Content />
      </div>

      {entry.data.keywords.length > 0 && <p class="sr-only" data-pagefind-weight="4">{entry.data.keywords.join(', ')}</p>}

      {
        related.length > 0 && (
          <section class="related" aria-labelledby="veja-tambem" data-pagefind-ignore>
            <h2 id="veja-tambem">Veja também</h2>
            <div class="cards">
              {related.map((r) => (
                <ArticleCard entry={r} />
              ))}
            </div>
          </section>
        )
      }

      <PrevNext prev={prev} next={next} />
    </article>

    <aside class="toc-aside" aria-label="Índice do artigo">
      <Toc headings={headings} />
    </aside>
  </div>
</BaseLayout>
